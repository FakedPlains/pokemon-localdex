# ── 数据源选择 ──
# "sqlite" (默认) 或 "supabase"
DATA_SOURCE=sqlite

# ── SQLite 配置（DATA_SOURCE=sqlite 时使用） ──
# 自定义 SQLite 数据库路径（可选，默认 data/sqlite/localdex.sqlite）
# LOCALDEX_DB_PATH=

# ── Supabase 配置（DATA_SOURCE=supabase 时使用） ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 服务端口 ──
PORT=3030
