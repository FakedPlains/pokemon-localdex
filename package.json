{
  "name": "pokemon-localdex",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/store/*"
  ],
  "scripts": {
    "dev:api": "node --enable-source-maps apps/api/src/server.ts",
    "dev:web": "npm run dev -w @pokemon-localdex/web",
    "dev:worker": "wrangler dev apps/api/src/worker.ts --env development",
    "build:web": "npm run build -w @pokemon-localdex/web",
    "check:web:static": "eslint --no-inline-config apps/web/src --ext .ts,.tsx",
    "check:web:unit": "node --enable-source-maps --import tsx --test apps/web/src/**/*.test.ts",
    "build:cf": "npm run build:web && wrangler deploy --dry-run",
    "check:api": "node --enable-source-maps apps/api/src/smoke.ts",
    "check:sqlite": "node --enable-source-maps packages/store/sqlite-store/src/demo.ts",
    "check:damage": "node --enable-source-maps packages/battle-core/src/smoke.ts",
    "db:ensure": "node --enable-source-maps packages/store/sqlite-store/src/import-db.ts",
    "d1:create": "wrangler d1 create pokemon-localdex-d1",
    "d1:migrate": "wrangler d1 execute pokemon-localdex-d1 --file=schema/d1-schema.sql",
    "d1:migrate:remote": "wrangler d1 execute pokemon-localdex-d1 --remote --file=schema/d1-schema.sql",
    "worker:dev": "wrangler dev --config wrangler.worker.toml",
    "worker:deploy": "wrangler deploy --config wrangler.worker.toml",
    "deploy:cf": "npm run build:web && wrangler pages deploy dist --project-name=pokemon-localdex --commit-dirty=true",
    "crawl": "python3 packages/crawler_py/crawl-52poke-db.py",
    "crawl:all": "python3 packages/crawler_py/crawl-52poke-db.py all",
    "crawl:pokemon": "python3 packages/crawler_py/crawl-52poke-db.py pokemon",
    "crawl:champions": "python3 packages/crawler_py/crawl-52poke-db.py champions",
    "crawl:catalog": "python3 packages/crawler_py/crawl-52poke-db.py catalog",
    "crawl:abilities": "python3 packages/crawler_py/crawl-52poke-db.py abilities",
    "crawl:moves": "python3 packages/crawler_py/crawl-52poke-db.py moves",
    "crawl:items": "python3 packages/crawler_py/crawl-52poke-db.py items"
  },
  "dependencies": {
    "@fakedplains/smogon-calc": "^0.11.1",
    "@hono/node-server": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "8.41.0",
    "wrangler": "^3.99.0"
  }
}
